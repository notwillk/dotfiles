[color]
  ui = true

[core]
  autocrlf = input

[push]
  default = upstream
  autoSetupRemote = true

[alias]
  git = !git
  st = status --short --branch
  cm = commit -m
  br = branch
  co = checkout
  cp = cherry-pick
  df = diff
  dc = diff --cached
  dt = difftool
  ls = ls-files
  pr = "!git fetch && git pull --rebase"
  lol = log --graph --decorate --pretty=oneline --abbrev-commit
  lola = log --graph --decorate --pretty=oneline --abbrev-commit --all
  sha = rev-parse HEAD
  log = log --decorate
  head = log --stat --decorate -1 HEAD
  undo = reset --soft HEAD^
  aliases = !git config --get-regexp ^alias | cut -c 7-
  recent = !git for-each-ref --sort=-committerdate refs/heads/ --format='%(refname)' | cut -c 12- | head
  wip = "!sh -c 'git commit -m \"WIP: $(date \"+%Y-%m-%d %H:%M:%S\")\"'"
  unwip = "!f(){ msg=$(git log -1 --pretty=%B) && echo \"$msg\" | grep -Eq '^WIP(:|$)' && git reset --soft HEAD^ && f || true; }; f"
